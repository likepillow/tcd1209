# ACX720-V3-SCH.pdf page 1, U1B Bank 15, visually checked 2026-09-23.
# Bank 15 VCCO is VCC3V3 (page 3 U1I, visually checked 2026-09-23).
# Placement and voltage only: external timing still required before deployment.
set_property IOSTANDARD LVCMOS33 [get_ports usb_*]
# Board-local 48 MHz bus: specify output slew/drive instead of tool defaults.
# Physical signal integrity/load must still be checked on hardware.
set_property SLEW FAST [get_ports {usb_fd[*] usb_fifo_addr[*] usb_slrd_n usb_slwr_n usb_sloe_n usb_pktend_n usb_slcs_n}]
set_property DRIVE 8 [get_ports {usb_fd[*] usb_fifo_addr[*] usb_slrd_n usb_slwr_n usb_sloe_n usb_pktend_n usb_slcs_n}]
set_property PACKAGE_PIN L19 [get_ports usb_ifclk]
set_property PACKAGE_PIN K19 [get_ports usb_slrd_n]
set_property PACKAGE_PIN L20 [get_ports usb_slwr_n]
set_property PACKAGE_PIN J15 [get_ports usb_sloe_n]
set_property PACKAGE_PIN J14 [get_ports usb_pktend_n]
set_property PACKAGE_PIN J16 [get_ports usb_slcs_n]
set_property PACKAGE_PIN K13 [get_ports {usb_fifo_addr[0]}]
set_property PACKAGE_PIN H13 [get_ports {usb_fifo_addr[1]}]
set_property PACKAGE_PIN H17 [get_ports usb_flaga]
set_property PACKAGE_PIN H18 [get_ports usb_flagb]
set_property PACKAGE_PIN J17 [get_ports usb_flagc]
set_property PACKAGE_PIN G18 [get_ports {usb_fd[0]}]
set_property PACKAGE_PIN G17 [get_ports {usb_fd[1]}]
set_property PACKAGE_PIN G20 [get_ports {usb_fd[2]}]
set_property PACKAGE_PIN J20 [get_ports {usb_fd[3]}]
set_property PACKAGE_PIN G13 [get_ports {usb_fd[4]}]
set_property PACKAGE_PIN G16 [get_ports {usb_fd[5]}]
set_property PACKAGE_PIN K14 [get_ports {usb_fd[6]}]
set_property PACKAGE_PIN G15 [get_ports {usb_fd[7]}]
set_property PACKAGE_PIN L14 [get_ports {usb_fd[8]}]
set_property PACKAGE_PIN L15 [get_ports {usb_fd[9]}]
set_property PACKAGE_PIN K16 [get_ports {usb_fd[10]}]
set_property PACKAGE_PIN L16 [get_ports {usb_fd[11]}]
set_property PACKAGE_PIN K18 [get_ports {usb_fd[12]}]
set_property PACKAGE_PIN K17 [get_ports {usb_fd[13]}]
set_property PACKAGE_PIN J19 [get_ports {usb_fd[14]}]
set_property PACKAGE_PIN H19 [get_ports {usb_fd[15]}]
